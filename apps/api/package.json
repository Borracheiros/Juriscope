{
  "name": "@juridico-ia/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --testTimeout=120000",
    "migration:run": "tsx src/database/cli.ts run",
    "migration:show": "tsx src/database/cli.ts show",
    "migration:pending": "tsx src/database/cli.ts pending",
    "migration:fingerprint": "tsx src/database/cli.ts fingerprint"
  },
  "dependencies": {
    "@juridico-ia/config": "0.1.0",
    "@juridico-ia/contracts": "0.1.0",
    "@juridico-ia/domain": "0.1.0",
    "@juridico-ia/observability": "0.1.0",
    "@juridico-ia/security": "0.1.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "jose": "^6.0.12",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@juridico-ia/testing": "0.1.0",
    "@types/node": "^22.17.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
