{
  "name": "juridico-ia",
  "private": true,
  "version": "0.1.0",
  "description": "Juridico-IA — plataforma jurídica SaaS multi-tenant (fundação Sprint 0)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "secret-scan": "node scripts/secret-scan.cjs",
    "secret-scan:test": "node scripts/secret-scan.test.cjs",
    "proposta:extract": "node scripts/governance/extract-proposta-docx.cjs",
    "proposta:check": "node scripts/governance/extract-proposta-docx.cjs --check",
    "audit:evidence:manifest": "node scripts/governance/audit-evidence-manifest.cjs --write",
    "audit:evidence:check": "node scripts/governance/audit-evidence-manifest.cjs --check",
    "skills:sync": "node scripts/governance/sync-agent-skills.cjs",
    "skills:check": "node scripts/governance/sync-agent-skills.cjs --check",
    "audit:deps": "npm audit --audit-level=critical",
    "dev:api": "npm run start:dev -w @juridico-ia/api",
    "dev:web": "npm run dev -w @juridico-ia/web",
    "dev:worker": "npm run start:dev -w @juridico-ia/worker",
    "migration:run": "npm run migration:run -w @juridico-ia/api",
    "migration:show": "npm run migration:show -w @juridico-ia/api",
    "migration:pending": "npm run migration:pending -w @juridico-ia/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.8.3"
  }
}
