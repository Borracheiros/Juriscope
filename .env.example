NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:3000

# Owner/migrator — never use as API runtime. Password omitted from URL (set locally).
DATABASE_URL=postgresql://juridico@127.0.0.1:5432/juridico_ia

# Runtime API role (LOGIN/PASSWORD provisioned outside schema migrations).
DATABASE_APP_URL=postgresql://juridico_app@127.0.0.1:5432/juridico_ia

# Worker role (minimal privileges via SECURITY DEFINER functions).
WORKER_DATABASE_URL=postgresql://juridico_worker@127.0.0.1:5432/juridico_ia

# Local Compose secrets (not embedded in URLs above). Export before docker compose up.
# OWNER_PASSWORD=
# APP_PASSWORD=
# WORKER_PASSWORD=

SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
LOG_LEVEL=info
