NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://127.0.0.1:3000

# Owner/migrator (Docker Compose local). Nunca commitar senha real.
DATABASE_URL=postgresql://juridico:juridico@127.0.0.1:5432/juridico_ia

# Runtime da API (role sem superuser — RLS aplica). Gerada no init do Postgres.
DATABASE_APP_URL=postgresql://juridico_app:juridico_app@127.0.0.1:5432/juridico_ia

# Mínimo 32 caracteres. Só em .env local.
SESSION_SECRET=dev-only-change-me-to-a-long-random-string

COOKIE_SECURE=false
LOG_LEVEL=info
